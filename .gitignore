# ====================================================================
# Roland S-760 / MAME Project .gitignore
# ====================================================================

# Proprietary ROMs, BIOS dumps, and Floppy/Hard Disk images
roms/*
!roms/System/
!roms/System/.gitkeep
!roms/FDD/
!roms/FDD/.gitkeep
!roms/SCSI/
!roms/SCSI/.gitkeep
# IC15 boot ROM: track the README (how to obtain it) but NOT the ROM binaries.
# The actual *.BIN/*.HEX dumps stay ignored (copyrighted Roland firmware) via the
# global *.BIN/*.HEX/*.bin rules below.
!roms/BOOT/
!roms/BOOT/README.md
*.hex
*.HEX
*.rom
*.ROM
*.img
*.IMG
*.out
*.OUT
# Firmware image backups/compressed images are proprietary too.
*.img.bak
*.IMG.bak
*.img.gz
*.IMG.gz
*.img.zip
*.IMG.zip
*.img.7z
*.IMG.7z
# GB-6 generated artifacts: commit patch source and instructions only.
/patches/gb6/generated/
*.bin
*.BIN
*.iso
*.ISO
*.hda
*.HDA
*.raw
*.RAW
*.hfe
*.HFE
*.dsk
*.DSK
*.sdk
*.SDK
*.chd
*.CHD
*.wav
*.WAV
*.aiff
*.AIFF
# Other recordings, machine checkpoints and compressed CD images stay local.
*.[aA][iI][fF]
*.[fF][lL][aA][cC]
*.[mM][pP]3
*.s760state
*.s760state.*
*.[iI][sS][oO]
*.[iI][sS][oO].*

# Local environment credentials (example templates may be committed).
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Copyrighted manuals and documentation PDFs
Manuals/
Manuals/*
*.pdf
*.PDF


# MAME runtime data, saves, and screenshots
snap/
nvram/
cfg/
sta/
diff/
comments/
memcard/
inp/

# Build artifacts and compiled binaries
build/
bin/
obj/
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.obj
*.o
*.a
*.res
*.tlog
*.lastbuildstate
*.clap
*.vst3
*.pyd
mames760.exe
mames760.pdb
mames760.lib
mames760.exp

# Visual Studio & IDE files
.vs/
*.vcxproj.user
*.suo
*.user
.vscode/
.idea/

# Python cache & test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
temp/
.piggie/
.kiro/
.agents/
.codex/
.soundcheck/
sample_cds/

# Keep the retired scratch-tree path excluded if an old external workflow
# recreates it. Maintained hardware documentation lives in docs/hardware/.
docs/ic20-hle-findings/

# Original hardware captures stay local; commit summaries and hashes instead.
/test-recordings/
# Generated firmware exports contain user-supplied Roland code/data.
/firmware_source/
# Hardware recording bundles and generated MAME UI preferences stay local.
/tests/hardware_recordings/
/ui.ini
# Downloadable standalone binaries are GitHub release assets, not Git blobs.
/artifacts/standalone/*.zip
/error.log

# OS metadata
.DS_Store
Thumbs.db

# ====================================================================
# s760-os-compiler: derived firmware source + proprietary binaries
# (Requirement 15.2 — derived/generated source and proprietary binaries
#  are excluded from the distributable file set. S760224.IMG, *.IMG/*.img,
#  *.BIN/*.bin, roms/BOOT/*.BIN, temp/, and /firmware_source/ are already
#  covered by the rules above; the entries below make the compiler's own
#  derived-export locations explicit so the policy is self-documenting.)
# ====================================================================
# Generated/derived firmware source exported by export_firmware_source.py
# (and any sibling export dirs the toolchain writes).
/firmware_source/
/firmware_export/
firmware_source/
firmware_export/
# Derived disassembly / build outputs produced under temp/ by the toolchain.
temp/firmware_export/
temp/firmware_source/
temp/*.img
temp/*.IMG
temp/*.bin
temp/*.BIN
temp/*.map

# Local compiler/decompiler development, compatibility tools and supporting docs.
/compiler/
/decompiler/
/docs/firmware/authoring/
/docs/firmware/tooling/
/docs/testing/evidence/toolchain/
/examples/minimal_os/
/include/s760_registers.inc
/scripts/analyze_firmware_routines.py
/scripts/build_firmware_image.py
/scripts/decompile_firmware_routines.py
/scripts/export_firmware_source.py
/scripts/mcs96_assembler.py
/scripts/mcs96_firmware_source.py
/scripts/mcs96_isa.py
/scripts/mcs96_linker.py
/scripts/s760_os_build.py
/scripts/s760_qualify_toolchain.py
/scripts/reconcile_equates.py
/scripts/check_authoring_citations.py
/scripts/distribution_policy.py

# Compiler/decompiler unit, property, build, export and acceptance tests.
/tests/toolchain/
/tests/test_assembler_directives.py
/tests/test_authoring_citations.py
/tests/test_complete_mcs96_coverage.py
/tests/test_distribution_policy.py
/tests/test_example_project_build.py
/tests/test_exported_project_import.py
/tests/test_firmware_decompiler.py
/tests/test_firmware_routines.py
/tests/test_from_scratch_os_boot.py
/tests/test_ic15_source_export_and_rebuild.py
/tests/test_legacy_reconstruct_regression.py
/tests/test_linker_boundaries.py
/tests/test_mcs96_isa.py
/tests/test_milestone7_source_behavior_change.py
/tests/test_original_project_roundtrip_property.py
/tests/test_prop_*.py
/tests/test_reconcile_equates.py
/tests/test_rom_boot_os_loader.py
/tests/test_s760_emitter.py
/tests/test_s760_os_build.py
/tests/test_s760_os_build_orchestration.py
/tests/test_source_export_and_rebuild.py
/tests/test_source_toolchain_acceptance.py
/tests/test_toolchain_layout.py

# Generated property-test state.
/.hypothesis/

# Large generated runtime trace reports stay local; retain the written summaries.
/docs/condensed/validation/bluescsi-im1-bug-fixes-2026-10-20.json
/docs/condensed/validation/bluescsi-im1-owner-and-recovery-2026-10-21.json
