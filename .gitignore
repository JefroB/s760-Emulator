# ====================================================================
# Roland S-760 / MAME Project .gitignore
# ====================================================================

# Proprietary ROMs, BIOS dumps, and Floppy/Hard Disk images
roms/*
!roms/System/
!roms/System/.gitkeep
!roms/FDD/
!roms/FDD/.gitkeep
!roms/SCSI/
!roms/SCSI/.gitkeep
# IC20 BOOT ROM: track the README (how to obtain it) but NOT the ROM binaries.
# The actual *.BIN/*.HEX dumps stay ignored (copyrighted Roland firmware) via the
# global *.BIN/*.HEX/*.bin rules below.
!roms/BOOT/
!roms/BOOT/README.md
*.hex
*.HEX
*.rom
*.ROM
*.img
*.IMG
*.bin
*.BIN
*.iso
*.ISO
*.hda
*.HDA
*.raw
*.RAW
*.hfe
*.HFE
*.dsk
*.DSK
*.sdk
*.SDK
*.chd
*.CHD
*.wav
*.WAV
*.aiff
*.AIFF

# Copyrighted manuals and documentation PDFs
Manuals/
Manuals/*
*.pdf
*.PDF


# MAME runtime data, saves, and screenshots
snap/
nvram/
cfg/
sta/
diff/
comments/
memcard/
inp/

# Build artifacts and compiled binaries
build/
bin/
obj/
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.obj
*.o
*.a
*.res
*.tlog
*.lastbuildstate
*.clap
*.vst3
*.pyd
mames760.exe
mames760.pdb
mames760.lib
mames760.exp

# Visual Studio & IDE files
.vs/
*.vcxproj.user
*.suo
*.user
.vscode/
.idea/

# Python cache & test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
temp/
.piggie/
.kiro/
.agents/

# OS metadata
.DS_Store
Thumbs.db

