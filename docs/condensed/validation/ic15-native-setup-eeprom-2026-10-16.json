      "observer_source": "local cpu=manager.machine.devices[':maincpu']\nlocal space=cpu.spaces['program']\nconfig_write=space:install_write_tap(0x4caa,0x4d29,'config-write',function(a,d,m)\n local pc=cpu.state['PC'].value\n if pc>=0x5140 and pc<=0x53a0 then print(string.format('[CONFIGW] pc=%04x addr=%04x value=%04x mask=%04x',pc,a,d,m)) end\nend)\nconfig_read=space:install_read_tap(0x4caa,0x4d29,'config-read',function(a,d,m)\n local pc=cpu.state['PC'].value\n if pc>=0x5350 and pc<=0x53a0 then print(string.format('[CONFIGR] pc=%04x addr=%04x value=%04x mask=%04x',pc,a,d,m)) end\nend)\nlocal function field(port,name)\n for _,f in pairs(manager.machine.ioport.ports[port].fields) do if f.name==name then return f end end\n error('missing input '..port..':'..name)\nend\nlocal frames=0\nlocal mode=field(':PANEL1','Mode')\nlocal decrement=field(':PANEL0','S1')\nlocal exit=field(':PANEL1','Exit')\nmode:set_value(1)\nemu.register_frame_done(function()\n frames=frames+1\n if frames<=300 then mode:set_value(1) elseif frames==301 then mode:set_value(0) end\n if frames==330 then decrement:set_value(1) print('[INPUT] S1 down') elseif frames==334 then decrement:set_value(0) print('[INPUT] S1 up') end\n if frames==360 then exit:set_value(1) print('[INPUT] Exit down') elseif frames==364 then exit:set_value(0) print('[INPUT] Exit up') end\n if frames%30==0 then print(string.format('[SETUP] frame=%d pc=%04x selfid=%02x field=%02x event=%02x',frames,cpu.state['PC'].value,space:read_u8(0x4cab),space:read_u8(0x4d30),space:read_u8(0x4d31))) end\nend)\n",
