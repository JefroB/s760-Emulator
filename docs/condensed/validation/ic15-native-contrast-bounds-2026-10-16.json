  "returncode": 0,
  "observer_and_input_source": "local cpu=manager.machine.devices[':maincpu']\nlocal space=cpu.spaces['program']\nlocal function field(port,name) for _,f in pairs(manager.machine.ioport.ports[port].fields) do if f.name==name then return f end end error('missing input') end\nlocal mode=field(':PANEL1','Mode') local dec=field(':PANEL0','S1') local inc=field(':PANEL0','S2')\nlocal frames,stage,cooldown,boundframe=0,0,0,0\nmode:set_value(1)\ncontrast_write=space:install_write_tap(0x4cb0,0x4cb1,'contrast-bounds',function(a,d,m)\n local pc=cpu.state['PC'].value\n if pc>=0x58f3 and pc<=0x5940 then print(string.format('[EDIT] frame=%d pc=%04x value=%02x mask=%04x',frames,pc,(d>>8)&255,m)) end\nend)\nemu.register_frame_done(function()\n frames=frames+1 local pc=cpu.state['PC'].value local value=space:read_u8(0x4cb1)\n if cooldown>0 then cooldown=cooldown-1 end\n if stage==0 then mode:set_value(1) if frames>90 and pc>=0x5741 and pc<=0x5809 then mode:set_value(0) stage=1 cooldown=30 print('[ENTERED] contrast field='..space:read_u8(0x4d30)) end\n elseif stage==1 and cooldown==0 then dec:set_value(1) stage=2 print('[INPUT] S1 held')\n elseif stage==2 and value==0xce then if boundframe==0 then boundframe=frames end if frames-boundframe>=120 then dec:set_value(0) stage=3 cooldown=30 boundframe=0 print('[LOWER] '..frames) end\n elseif stage==3 and cooldown==0 then inc:set_value(1) stage=4 print('[INPUT] S2 held')\n elseif stage==4 and value==0x32 then if boundframe==0 then boundframe=frames end if frames-boundframe>=120 then inc:set_value(0) stage=5 print('[UPPER] '..frames) end end\n if frames%60==0 then print(string.format('[STATE] frame=%d pc=%04x stage=%d contrast=%02x',frames,pc,stage,value)) end\nend)\n",
