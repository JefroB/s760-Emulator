  "returncode": 0,
  "observer_and_input_source": "local cpu=manager.machine.devices[':maincpu'] local space=cpu.spaces['program']\nlocal function field(port,name) for _,f in pairs(manager.machine.ioport.ports[port].fields) do if f.name==name then return f end end error('missing input') end\nlocal mode=field(':PANEL1','Mode') local dec=field(':PANEL0','S1') local inc=field(':PANEL0','S2') local up=field(':PANEL1','Panel Up') local down=field(':PANEL3','Panel Down')\nlocal frames,stage,cooldown,boundframe,current=0,0,0,0,1 local pulseheld=nil\nlocal tests={{selection=0,address=0x4cab,max=7,name='self_id'},{selection=1,address=0x4caf,max=9,name='boot_drive'},{selection=2,address=0x4cb2,max=2,name='controller'}}\nmode:set_value(1)\nmenu_write=space:install_write_tap(0x4caa,0x4cb3,'menu-bounds',function(a,d,m)\nlocal pc=cpu.state['PC'].value if pc>=0x581b and pc<0x58f3 then print(string.format('[EDIT] frame=%d pc=%04x addr=%04x value=%04x mask=%04x',frames,pc,a,d,m)) end\nend)\nlocal function pulse(f) f:set_value(1) pulseheld=f cooldown=30 end\nemu.register_frame_done(function()\nframes=frames+1 if pulseheld then pulseheld:set_value(0) pulseheld=nil end if cooldown>0 then cooldown=cooldown-1 end\nlocal pc=cpu.state['PC'].value local test=tests[current]\nif stage==0 then mode:set_value(1) if frames>90 and pc>=0x5741 and pc<=0x5809 then mode:set_value(0) stage=1 cooldown=30 print('[ENTERED] setup') end\nelseif stage==1 and cooldown==0 then\n local selection=space:read_u8(0x4d30)\n if selection>test.selection then pulse(up) elseif selection<test.selection then pulse(down) else dec:set_value(1) stage=2 boundframe=0 print('[INPUT] '..test.name..' S1 held') end\nelseif stage==2 and space:read_u8(test.address)==0 then\n if boundframe==0 then boundframe=frames end if frames-boundframe>=120 then dec:set_value(0) stage=3 cooldown=30 print('[LOWER] '..test.name) end\nelseif stage==3 and cooldown==0 then inc:set_value(1) stage=4 boundframe=0 print('[INPUT] '..test.name..' S2 held')\nelseif stage==4 and space:read_u8(test.address)==test.max then\n if boundframe==0 then boundframe=frames end if frames-boundframe>=120 then inc:set_value(0) current=current+1 cooldown=30 stage=current>#tests and 5 or 1 print('[UPPER] '..test.name) end end\nif frames%60==0 then print(string.format('[STATE] frame=%d stage=%d field=%02x id=%02x boot=%02x controller=%02x',frames,stage,space:read_u8(0x4d30),space:read_u8(0x4cab),space:read_u8(0x4caf),space:read_u8(0x4cb2))) end\nend)\n",
