  "decision": "Reuse the DMA mechanism; fixed staging wrappers and unbounded wait are not approved as a bounded importer service.",
  "required_adapter": [
    "Even nonzero byte count <=4096, never zero-encoded DMA length.",
    "Source extent confined to owned RAM and destination extent confined to one reserved channel.",
    "Explicit wave word address and physical CPU RAM source address.",
    "Exclusive DMA ownership and preservation of caller selectors/scratch/interrupt state.",
    "Bounded progress wait and qualified abort/cleanup before releasing allocation.",
    "Native write-extent tests with distinct channel data and adjacent sentinels."
  ],
  "limitations": [
    "No direct-call register/stack contract verified.",
    "No physical DMA timing or abort guarantee.",
    "No native deinterleaving or stereo publication.",
    "No new firmware size measurement."
