  "returncode": 0,
  "observer_and_input_source": "local cpu=manager.machine.devices[':maincpu']\nlocal space=cpu.spaces['program']\nlocal function field(port,name) for _,f in pairs(manager.machine.ioport.ports[port].fields) do if f.name==name then return f end end error('input missing') end\nlocal mode=field(':PANEL1','Mode')\nlocal up=field(':PANEL1','Panel Up')\nlocal inc=field(':PANEL0','S2')\nlocal dec=field(':PANEL0','S1')\nlocal exit=field(':PANEL1','Exit')\nmode:set_value(1)\nlocal frames=0\nlocal stage=0\nlocal cooldown=0\nlocal held=nil\nlocal writes=0\nscsi_tap=space:install_write_tap(0xe400,0xe41f,'boot-scsi',function(a,d,m)\nif writes<4096 then print(string.format('[SCSI] pc=%04x addr=%04x value=%04x mask=%04x',cpu.state['PC'].value,a,d,m)) end writes=writes+1\nend)\nhandoff=space:install_write_tap(0x0106,0x0107,'handoff',function(a,d,m) print(string.format('[HANDOFF] pc=%04x value=%04x mask=%04x',cpu.state['PC'].value,d,m)) end)\nlocal function pulse(f,name) f:set_value(1) held=f cooldown=30 print('[INPUT] '..name) end\nemu.register_frame_done(function()\nframes=frames+1\nlocal pc=cpu.state['PC'].value\nif held then held:set_value(0) held=nil end\nif cooldown>0 then cooldown=cooldown-1 end\nif stage==0 then\n mode:set_value(1)\n if frames>90 and pc>=0x5741 and pc<=0x5809 then mode:set_value(0) stage=1 cooldown=30 print('[ENTERED] setup') end\nelseif stage==1 and cooldown==0 then\n local selection=space:read_u8(0x4d30)\n if selection>1 then pulse(up,'Panel Up') elseif selection==1 then stage=2 cooldown=30 else error('unexpected selection') end\nelseif stage==2 and cooldown==0 then\n local boot=space:read_u8(0x4caf)\n if boot<2 then pulse(inc,'S2') elseif boot>2 then pulse(dec,'S1') else stage=3 cooldown=30 end\nelseif stage==3 and cooldown==0 then pulse(exit,'Exit') stage=4 end\nif frames%60==0 then print(string.format('[STATE] frame=%d pc=%04x stage=%d field=%02x boot=%02x target=%02x type=%02x',frames,pc,stage,space:read_u8(0x4d30),space:read_u8(0x4caf),space:read_u8(0x4c51),space:read_u8(0x4c5b))) end\nend)\n",
