  "observer_and_input_source": "local cpu=manager.machine.devices[':maincpu'] local space=cpu.spaces['program']\nlocal mode=nil for _,f in pairs(manager.machine.ioport.ports[':PANEL1'].fields) do if f.name=='Mode' then mode=f end end assert(mode)\nmode:set_value(1)\nlocal reads=0\nencoder_read=space:install_read_tap(0xf012,0xf013,'encoder-read',function(a,d,m)\nif reads<10 then print(string.format('[ENCODER] pc=%04x value=%04x mask=%04x',cpu.state['PC'].value,d,m)) end reads=reads+1\nend)\nencoder_write=space:install_write_tap(0xf012,0xf013,'encoder-clear',function(a,d,m)\nif reads<10 then print(string.format('[CLEAR] pc=%04x value=%04x mask=%04x',cpu.state['PC'].value,d,m)) end\nend)\ncontrast=space:install_write_tap(0x4cb0,0x4cb1,'contrast',function(a,d,m)\nlocal pc=cpu.state['PC'].value if pc>=0x58f3 and pc<=0x5940 then print(string.format('[EDIT] pc=%04x value=%02x',pc,(d>>8)&255)) end\nend)\nlocal frames=0 emu.register_frame_done(function()\nframes=frames+1 mode:set_value(1) if frames%30==0 then print(string.format('[STATE] frame=%d pc=%04x contrast=%02x',frames,cpu.state['PC'].value,space:read_u8(0x4cb1))) end\nend)\n",
